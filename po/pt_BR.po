#: prefs.js:18 lib/customization.js:393
msgid "Quick Settings"
msgstr "Configurações rápidas"

#: prefs.js:23 prefs.js:92
msgid "Calendar"
msgstr "Calendário"

#: prefs.js:30
msgid "Tiles"
msgstr "Blocos"

#: prefs.js:31
msgid "Edit with the pencil in Quick Settings: drag to move, click to resize"
msgstr "Edite com o lápis nas configurações rápidas: arraste para mover, clique para redimensionar"

#: prefs.js:34 lib/widgets/controls.js:22 lib/widgets/controls.js:29
#: lib/widgets/registry.js:77
msgid "Controls"
msgstr "Controles"

#: prefs.js:36
msgid "Notifications"
msgstr "Notificações"

#: prefs.js:40
msgid "Customization"
msgstr "Personalização do menu"

#: prefs.js:41
msgid "Add an edit button to add, remove, move and resize quick settings"
msgstr ""
"Adiciona um botão de edição para adicionar, remover, mover e redimensionar "
"configurações rápidas"

#: prefs.js:45
msgid "Hide Accessibility Menu"
msgstr "Ocultar menu de acessibilidade"

#: prefs.js:46
msgid "Accessibility toggles can be added to Quick Settings instead"
msgstr ""
"Os controles de acessibilidade podem ser adicionados às Configurações rápidas"

#: prefs.js:52
msgid "Default Layout"
msgstr "Layout padrão"

#: prefs.js:53
msgid "Restore the quick settings that were removed, added, moved or resized"
msgstr ""
"Restaura as configurações rápidas removidas, adicionadas, movidas ou "
"redimensionadas"

#: prefs.js:56 prefs.js:141
msgid "Reset"
msgstr "Restaurar"

#: prefs.js:69
msgid "Android Style Tiles"
msgstr "Blocos no estilo do Android"

#: prefs.js:70
msgid ""
"Taller rounded tiles with the icon in a rounded square, as on Android 16"
msgstr ""
"Blocos mais altos e arredondados, com o ícone num quadrado arredondado, como "
"no Android 16"

#: prefs.js:73
msgid "Pill Sliders"
msgstr "Sliders em pílula"

#: prefs.js:74
msgid "Thick sliders with the icon inside the filled part"
msgstr "Sliders largos com o ícone dentro da parte preenchida"

#: prefs.js:77
msgid "Volume of Each App"
msgstr "Volume de cada aplicativo"

#: prefs.js:78
msgid ""
"The menu of the volume slider lists the apps playing sound, each with a "
"slider"
msgstr ""
"O menu do controle de volume lista os aplicativos que estão tocando som, "
"cada um com seu controle"

#: prefs.js:81
msgid "Top Bar Shortcuts"
msgstr "Atalhos na barra superior"

#: prefs.js:82
msgid ""
"Middle-click the volume icon to mute; scroll over the battery icon to change "
"the brightness"
msgstr ""
"Botão do meio no ícone de volume deixa mudo; rolar sobre o ícone da bateria "
"muda o brilho"

#: prefs.js:85
msgid "Do Not Disturb Durations"
msgstr "Durações do Não perturbe"

#: prefs.js:86
msgid "Turn on Do Not Disturb for an hour, until the evening or until tomorrow"
msgstr "Ativa o Não perturbe por uma hora, até a noite ou até amanhã"

#: prefs.js:89
msgid "Notifications in Quick Settings"
msgstr "Notificações nas Configurações rápidas"

#: prefs.js:90
msgid ""
"Quick Settings and notifications collapse into each other, with a media "
"player"
msgstr ""
"Configurações rápidas e notificações se recolhem uma na outra, com um player "
"de mídia"

#: prefs.js:95 prefs.js:131 lib/widgets/gallery.js:163
msgid "Widgets"
msgstr "Widgets"

#: prefs.js:96
msgid "Click Edit Widgets under the calendar to add, move and resize them"
msgstr "Clique em Editar widgets, embaixo do calendário, para adicionar, mover e redimensionar"

#: prefs.js:101
msgid "Adaptive Calendar"
msgstr "Calendário adaptável"

#: prefs.js:102
msgid "A calendar popover that scales with events, world clocks and weather"
msgstr "Um calendário que se adapta aos eventos, relógios mundiais e clima"

#: prefs.js:107
msgid "Layout"
msgstr "Layout"

#: prefs.js:108
msgid ""
"Two columns always shows the date, weather and events next to the calendar"
msgstr ""
"Duas colunas sempre mostra a data, o clima e os eventos ao lado do calendário"

#: prefs.js:109
msgid "Adaptive"
msgstr "Adaptável"

#: prefs.js:109
msgid "Two Columns"
msgstr "Duas colunas"

#: prefs.js:125
msgid "Show Events"
msgstr "Mostrar eventos"

#: prefs.js:126
msgid "Show the remaining events of the day next to the calendar"
msgstr "Mostra os próximos eventos do dia ao lado do calendário"

#: prefs.js:132
msgid "Weather, world clocks, events, media and more under the calendar"
msgstr "Clima, relógios mundiais, eventos, mídia e mais abaixo do calendário"

#: prefs.js:137
msgid "Default Widgets"
msgstr "Widgets padrão"

#: prefs.js:138
msgid "Restore the widgets that were added, removed or resized"
msgstr ""
"Restaura os widgets que foram adicionados, removidos ou redimensionados"

#: prefs.js:156
msgid "Stock Symbols (comma separated, e.g. PETR4.SA, AAPL, BTC-USD)"
msgstr ""
"Símbolos da bolsa (separados por vírgula, ex.: PETR4.SA, AAPL, BTC-USD)"

