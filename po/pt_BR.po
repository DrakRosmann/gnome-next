#: prefs.js:23 lib/customization.js:510
msgid "Quick Settings"
msgstr "Configurações rápidas"

#: prefs.js:28 prefs.js:163
msgid "Calendar"
msgstr "Calendário"

#: prefs.js:35
msgid "Tiles"
msgstr "Blocos"

#: prefs.js:36
msgid "Edit with the pencil in Quick Settings: drag to move, click to resize"
msgstr ""
"Edite com o lápis nas configurações rápidas: arraste para mover, clique para "
"redimensionar"

#: prefs.js:39 lib/toggles.js:21 lib/widgets/controls.js:22
#: lib/widgets/controls.js:29 lib/widgets/registry.js:78
msgid "Controls"
msgstr "Controles"

#: prefs.js:41
msgid "Notifications"
msgstr "Notificações"

#: prefs.js:45
msgid "Customization"
msgstr "Personalização do menu"

#: prefs.js:46
msgid "Add an edit button to add, remove, move and resize quick settings"
msgstr ""
"Adiciona um botão de edição para adicionar, remover, mover e redimensionar "
"configurações rápidas"

#: prefs.js:50
msgid "Hide Accessibility Menu"
msgstr "Ocultar menu de acessibilidade"

#: prefs.js:51
msgid "Accessibility toggles can be added to Quick Settings instead"
msgstr ""
"Os controles de acessibilidade podem ser adicionados às Configurações rápidas"

#: prefs.js:57
msgid "Default Layout"
msgstr "Layout padrão"

#: prefs.js:58
msgid "Restore the quick settings that were removed, added, moved or resized"
msgstr ""
"Restaura as configurações rápidas removidas, adicionadas, movidas ou "
"redimensionadas"

#: prefs.js:61 prefs.js:212
msgid "Reset"
msgstr "Restaurar"

#: prefs.js:75
msgid "Android Style Tiles"
msgstr "Blocos no estilo do Android"

#: prefs.js:76
msgid ""
"Taller rounded tiles with the icon in a rounded square, as on Android 16"
msgstr ""
"Blocos mais altos e arredondados, com o ícone num quadrado arredondado, como "
"no Android 16"

#: prefs.js:79
msgid "Time and Date"
msgstr "Hora e data"

#: prefs.js:80
msgid "The time and date at the top of Quick Settings, as on One UI"
msgstr "A hora e a data no topo das configurações rápidas, como no One UI"

#: prefs.js:83
msgid "Weather in the Top Bar"
msgstr "Clima na barra superior"

#: prefs.js:84
msgid "The weather icon and temperature next to the date"
msgstr "O ícone do clima e a temperatura ao lado da data"

#: prefs.js:87
msgid "Panel Animations"
msgstr "Animações do painel"

#: prefs.js:88
msgid ""
"Quick Settings springs open from its button with the controls in a wave; "
"sliders grow while dragged"
msgstr ""
"O painel abre com mola a partir do botão e os controles aparecem em onda; os "
"sliders crescem ao arrastar"

#: prefs.js:91
msgid "Pill Sliders"
msgstr "Sliders em pílula"

#: prefs.js:92
msgid "Thick sliders with the icon inside the filled part"
msgstr "Sliders largos com o ícone dentro da parte preenchida"

#: prefs.js:95
msgid "Volume of Each App"
msgstr "Volume de cada aplicativo"

#: prefs.js:96
msgid ""
"The menu of the volume slider lists the apps playing sound, each with a "
"slider"
msgstr ""
"O menu do controle de volume lista os aplicativos que estão tocando som, "
"cada um com seu controle"

#: prefs.js:99
msgid "Top Bar Shortcuts"
msgstr "Atalhos na barra superior"

#: prefs.js:100
msgid ""
"Middle-click the volume icon to mute; scroll over the battery icon to change "
"the brightness"
msgstr ""
"Botão do meio no ícone de volume deixa mudo; rolar sobre o ícone da bateria "
"muda o brilho"

#: prefs.js:103
msgid "Do Not Disturb Durations"
msgstr "Durações do Não perturbe"

#: prefs.js:104
msgid "Turn on Do Not Disturb for an hour, until the evening or until tomorrow"
msgstr "Ativa o Não perturbe por uma hora, até a noite ou até amanhã"

#: prefs.js:107
msgid "Connection Details"
msgstr "Detalhes da conexão"

#: prefs.js:108
msgid "Show the wired speed and the Bluetooth battery under the toggle names"
msgstr ""
"Mostra a velocidade da rede cabeada e a bateria do Bluetooth embaixo do nome "
"dos botões"

#: prefs.js:111 lib/live.js:991
msgid "Live Activities"
msgstr "Atividades ao vivo"

#: prefs.js:112
msgid ""
"Timers, music, screen recordings and downloads in an island in the top bar "
"and in Quick Settings"
msgstr ""
"Timers, música, gravações de tela e downloads numa ilha na barra superior e "
"nas configurações rápidas"

#: prefs.js:116
msgid "Notifications From the Island"
msgstr "Notificações saindo da ilha"

#: prefs.js:117
msgid "Notifications grow out of the island and go back into it"
msgstr "As notificações saem da ilha e voltam para ela"

#: prefs.js:122
msgid "Volume and Brightness in the Island"
msgstr "Volume e brilho na ilha"

#: prefs.js:123
msgid ""
"The island shows the level instead of the popup in the middle of the screen"
msgstr "A ilha mostra o nível no lugar do aviso no meio da tela"

#: prefs.js:128
msgid "Open the Island on Hover"
msgstr "Abrir a ilha ao passar o mouse"

#: prefs.js:129
msgid "Resting the pointer on the island opens its card"
msgstr "Parar o ponteiro sobre a ilha abre o cartão dela"

#: prefs.js:134
msgid "Player on the Lock Screen"
msgstr "Player na tela de bloqueio"

#: prefs.js:135
msgid ""
"A large player with the cover under the clock while the screen is locked"
msgstr ""
"Um player grande com a capa embaixo do relógio enquanto a tela está bloqueada"

#: prefs.js:138
msgid "Clipboard History and Emoji (Super+V, Super+.)"
msgstr "Histórico da área de transferência e emojis (Super+V, Super+.)"

#: prefs.js:139
msgid ""
"Super+V shows what you copied lately to paste it, Super+. the emoji; pinned "
"items stay. Super+M still opens the notification list"
msgstr ""
"Super+V mostra o que você copiou recentemente para colar, Super+. os emojis; "
"itens fixados ficam. Super+M continua abrindo a lista de notificações"

#: prefs.js:142
msgid "Clipboard Button in the Top Bar"
msgstr "Botão da área de transferência na barra superior"

#: prefs.js:143
msgid "Opens the clipboard history with a click"
msgstr "Abre o histórico da área de transferência com um clique"

#: prefs.js:146
msgid "App Shortcuts"
msgstr "Atalhos de apps"

#: prefs.js:147
msgid ""
"Apps that open from Quick Settings; your favorite apps are also offered in "
"the editor"
msgstr ""
"Apps que abrem pelas configurações rápidas; seus apps favoritos também "
"aparecem no editor"

#: prefs.js:153
msgid "Custom Commands"
msgstr "Comandos personalizados"

#: prefs.js:154
msgid "Toggles that run your commands, e.g. to start a VPN or a server"
msgstr ""
"Botões que executam seus comandos, por exemplo para ligar uma VPN ou um "
"servidor"

#: prefs.js:160
msgid "Notifications in Quick Settings"
msgstr "Notificações nas Configurações rápidas"

#: prefs.js:161
msgid ""
"Quick Settings and notifications collapse into each other, with a media "
"player"
msgstr ""
"Configurações rápidas e notificações se recolhem uma na outra, com um player "
"de mídia"

#: prefs.js:166 prefs.js:202 lib/widgets/gallery.js:199
msgid "Widgets"
msgstr "Widgets"

#: prefs.js:167
msgid "Click Edit Widgets under the calendar to add, move and resize them"
msgstr ""
"Clique em Editar widgets, embaixo do calendário, para adicionar, mover e "
"redimensionar"

#: prefs.js:172
msgid "Adaptive Calendar"
msgstr "Calendário adaptável"

#: prefs.js:173
msgid "A calendar popover that scales with events, world clocks and weather"
msgstr "Um calendário que se adapta aos eventos, relógios mundiais e clima"

#: prefs.js:178
msgid "Layout"
msgstr "Layout"

#: prefs.js:179
msgid ""
"Two columns always shows the date, weather and events next to the calendar"
msgstr ""
"Duas colunas sempre mostra a data, o clima e os eventos ao lado do calendário"

#: prefs.js:180
msgid "Adaptive"
msgstr "Adaptável"

#: prefs.js:180
msgid "Two Columns"
msgstr "Duas colunas"

#: prefs.js:196
msgid "Show Events"
msgstr "Mostrar eventos"

#: prefs.js:197
msgid "Show the remaining events of the day next to the calendar"
msgstr "Mostra os próximos eventos do dia ao lado do calendário"

#: prefs.js:203
msgid "Weather, world clocks, events, media and more under the calendar"
msgstr "Clima, relógios mundiais, eventos, mídia e mais abaixo do calendário"

#: prefs.js:208
msgid "Default Widgets"
msgstr "Widgets padrão"

#: prefs.js:209
msgid "Restore the widgets that were added, removed or resized"
msgstr ""
"Restaura os widgets que foram adicionados, removidos ou redimensionados"

#: prefs.js:230
msgid "Stock Symbols (comma separated, e.g. PETR4.SA, AAPL, BTC-USD)"
msgstr ""
"Símbolos da bolsa (separados por vírgula, ex.: PETR4.SA, AAPL, BTC-USD)"

